{
  "name": "my-product-display",
  "version": "6.4.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "amazon-paapi": "^1.1.0",
    "emailjs-com": "^3.2.0",
    "firebase": "^12.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.16.0",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "prebuild": "node scripts/version-manager.js",
    "start": "cross-env VITE_VERSION=$npm_package_version vite",
    "build": "cross-env VITE_VERSION=$npm_package_version vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && firebase deploy --only hosting,database,storage",
    "publish": "npm run build && npm run deploy",
    "lint": "npx eslint src/**/*.{js,jsx} --max-warnings=0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "unused-imports"
    ],
    "rules": {
      "unused-imports/no-unused-imports": "warn"
    },
    "overrides": [
      {
        "files": [
          "**/__tests__/**/*",
          "**/*.{spec,test}.*"
        ],
        "globals": {
          "vi": "readonly"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-admin": "^10.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  }
}
